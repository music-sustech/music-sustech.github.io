---
/**
 * Search.astro — Pagefind search overlay
 *
 * Renders a magnifying-glass trigger button. On click (or Cmd/Ctrl+K),
 * a full-screen modal loads Pagefind's JS + CSS on demand and shows
 * an auto-focussed search input with live results.
 *
 * Usage:  <Search />   (then wire the button into the nav yourself)
 *
 * Pagefind index must exist at /_pagefind/ (generated by the build
 * workflow's `pagefind --site dist` step). The index path is base-aware.
 */
const pagefindUrl = `${import.meta.env.BASE_URL}_pagefind/pagefind.js`;
---

<!-- Trigger button — a small magnifying-glass icon suitable for the nav bar -->
<button
  id="search-trigger"
  type="button"
  class="inline-flex items-center justify-center rounded-md p-2 text-muted transition-colors hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
  aria-label="Open search"
>
  <svg
    class="h-5 w-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="8" />
    <line x1="21" y1="21" x2="16.65" y2="16.65" />
  </svg>
</button>

<!-- Search modal (hidden by default) -->
<div
  id="search-overlay"
  class="fixed inset-0 z-[100] hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site search"
>
  <!-- Backdrop -->
  <div id="search-backdrop" class="absolute inset-0 bg-ink/50 backdrop-blur-sm"></div>

  <!-- Modal panel -->
  <div class="relative mx-auto mt-[10vh] flex max-h-[75vh] w-full max-w-2xl flex-col rounded-lg border border-line bg-paper shadow-2xl sm:mx-4 md:mx-auto">
    <!-- Header: input + close -->
    <div class="flex items-center gap-2 border-b border-line px-4 py-3">
      <svg
        class="h-5 w-5 shrink-0 text-muted"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search the site..."
        autocomplete="off"
        class="flex-1 border-0 bg-transparent text-ink placeholder:text-muted focus:outline-none"
      />
      <kbd class="hidden rounded border border-line px-1.5 py-0.5 text-xs text-muted sm:inline-block">Esc</kbd>
      <button
        id="search-close"
        type="button"
        class="inline-flex items-center justify-center rounded-md p-1 text-muted transition-colors hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label="Close search"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <!-- Results area -->
    <div id="search-results" class="overflow-y-auto px-4 py-4">
      <p id="search-placeholder" class="text-center text-sm text-muted">
        Type to start searching
      </p>
    </div>
  </div>
</div>

<!-- Pagefind CSS overrides — injected once, matches both light and dark themes -->
<style is:global>
  /* Pagefind UI overrides — light mode */
  :root {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-ink);
    --pagefind-ui-background: var(--color-paper);
    --pagefind-ui-border: var(--color-line);
    --pagefind-ui-tag: var(--color-accent-soft);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-image-border-radius: 0.375rem;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: var(--font-sans);
  }

  /* Dark mode overrides (follows .dark on <html>) */
  .dark {
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-ink);
    --pagefind-ui-background: var(--color-paper);
    --pagefind-ui-border: var(--color-line);
    --pagefind-ui-tag: var(--color-accent-soft);
  }

  /* Custom result styling inside our modal */
  #search-results .search-result {
    border-bottom: 1px solid var(--color-line);
    padding: 0.75rem 0;
  }

  #search-results .search-result:last-child {
    border-bottom: none;
  }

  #search-results .search-result a {
    display: block;
    text-decoration: none;
    color: var(--color-ink);
    transition: color 0.15s;
  }

  #search-results .search-result a:hover {
    color: var(--color-accent);
  }

  #search-results .search-result-title {
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  #search-results .search-result-excerpt {
    font-size: 0.85rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  #search-results .search-result-excerpt mark {
    background-color: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 2px;
    padding: 0 2px;
  }

  /* No-results / loading states */
  #search-results .search-status {
    text-align: center;
    color: var(--color-muted);
    font-size: 0.875rem;
    padding: 1rem 0;
  }
</style>

<script is:inline define:vars={{ pagefindUrl }}>
  (function () {
    /* ------------------------------------------------------------------ */
    /*  DOM refs                                                          */
    /* ------------------------------------------------------------------ */
    const trigger = document.getElementById('search-trigger');
    const overlay = document.getElementById('search-overlay');
    const backdrop = document.getElementById('search-backdrop');
    const input = document.getElementById('search-input');
    const closeBtn = document.getElementById('search-close');
    const resultsEl = document.getElementById('search-results');
    const placeholder = document.getElementById('search-placeholder');

    if (!trigger || !overlay || !backdrop || !input || !closeBtn || !resultsEl) return;

    /* ------------------------------------------------------------------ */
    /*  State                                                             */
    /* ------------------------------------------------------------------ */
    let pagefind = null;       // Pagefind instance, loaded on first open
    let loading = false;       // True while Pagefind JS is being fetched
    let debounceTimer = null;

    /* ------------------------------------------------------------------ */
    /*  Open / close helpers                                              */
    /* ------------------------------------------------------------------ */
    function openSearch() {
      overlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      input.focus();
      loadPagefind();          // ensure Pagefind is ready
    }

    function closeSearch() {
      overlay.classList.add('hidden');
      document.body.style.overflow = '';
      input.value = '';
      if (resultsEl && placeholder) {
        resultsEl.innerHTML = '';
        resultsEl.appendChild(placeholder);
        placeholder.textContent = 'Type to start searching';
      }
      trigger.focus();
    }

    /* ------------------------------------------------------------------ */
    /*  Load Pagefind on demand                                           */
    /* ------------------------------------------------------------------ */
    async function loadPagefind() {
      if (pagefind || loading) return;
      loading = true;
      try {
        pagefind = await import(pagefindUrl);
        await pagefind.init();
      } catch (e) {
        console.warn('[Search] Could not load Pagefind index:', e);
        pagefind = null;
      } finally {
        loading = false;
      }
    }

    /* ------------------------------------------------------------------ */
    /*  Perform search                                                    */
    /* ------------------------------------------------------------------ */
    async function performSearch(query) {
      if (!query || query.trim().length === 0) {
        resultsEl.innerHTML = '';
        resultsEl.appendChild(placeholder);
        placeholder.textContent = 'Type to start searching';
        return;
      }

      if (!pagefind) {
        resultsEl.innerHTML = '<p class="search-status">Loading search index...</p>';
        await loadPagefind();
        if (!pagefind) {
          resultsEl.innerHTML = '<p class="search-status">Search index unavailable. Try again after a full build.</p>';
          return;
        }
      }

      const search = await pagefind.search(query);

      if (search.results.length === 0) {
        resultsEl.innerHTML = '<p class="search-status">No results found.</p>';
        return;
      }

      // Load the first 8 results (enough for a modal view)
      const data = await Promise.all(
        search.results.slice(0, 8).map(r => r.data())
      );

      resultsEl.innerHTML = data
        .map(
          (item) => `
          <div class="search-result">
            <a href="${item.url}">
              <div class="search-result-title">${item.meta?.title || item.url}</div>
              <div class="search-result-excerpt">${item.excerpt}</div>
            </a>
          </div>`
        )
        .join('');
    }

    /* ------------------------------------------------------------------ */
    /*  Event listeners                                                   */
    /* ------------------------------------------------------------------ */

    // Open from trigger button
    trigger.addEventListener('click', openSearch);

    // Close from close button
    closeBtn.addEventListener('click', closeSearch);

    // Close on backdrop click
    backdrop.addEventListener('click', closeSearch);

    // Keyboard: Escape to close, Cmd/Ctrl+K to open
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
        e.preventDefault();
        closeSearch();
        return;
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (overlay.classList.contains('hidden')) {
          openSearch();
        } else {
          closeSearch();
        }
      }
    });

    // Live search on input with debounce
    input.addEventListener('input', function () {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function () {
        performSearch(input.value);
      }, 200);
    });

    // Simple focus trap: keep Tab within the modal while open
    overlay.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab') return;

      const focusable = overlay.querySelectorAll(
        'input, button, [href], [tabindex]:not([tabindex="-1"])'
      );
      if (focusable.length === 0) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>
