---
import { url } from '../../../lib/url';
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
---

<Base title={d.title} description={`${d.title} — MUSIC Lab News`}>
  <!-- Back link -->
  <nav class="mb-6">
    <a href={url('/updates/news')} class="text-sm text-accent hover:underline">&larr; All news</a>
  </nav>

  <!-- Date -->
  <time class="mb-2 block text-sm text-muted" datetime={d.date.toISOString().slice(0, 10)}>
    {d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
  </time>

  <!-- Title -->
  <h1 class="mb-6 text-3xl font-semibold leading-tight text-ink">{d.title}</h1>

  <!-- Tags -->
  {d.tags.length > 0 && (
    <div class="mb-6 flex flex-wrap gap-2">
      {d.tags.map((tag: string) => (
        <span class="rounded bg-accent-soft px-2 py-0.5 text-xs text-accent">{tag}</span>
      ))}
    </div>
  )}

  <!-- Body -->
  <article class="prose">
    <Content />
  </article>
</Base>
