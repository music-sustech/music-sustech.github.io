---
import { url } from '../../../lib/url';
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const blog = await getCollection('blog');
  return blog
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---

<Base title={d.title} description={d.excerpt ?? `${d.title} — MUSIC Lab Blog`}>
  <!-- Back link -->
  <nav class="mb-6">
    <a href={url('/updates/blog')} class="text-sm text-accent hover:underline">&larr; All blog posts</a>
  </nav>

  <!-- Date -->
  <time class="mb-2 block text-sm text-muted" datetime={d.date.toISOString().slice(0, 10)}>
    {d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
  </time>

  <!-- Title -->
  <h1 class="mb-2 text-3xl font-semibold leading-tight text-ink">{d.title}</h1>

  <!-- Author byline -->
  <p class="mb-4 text-sm text-muted">by {d.author}</p>

  <!-- Tags -->
  {d.tags.length > 0 && (
    <div class="mb-6 flex flex-wrap gap-2">
      {d.tags.map((tag: string) => (
        <span class="rounded bg-accent-soft px-2 py-0.5 text-xs text-accent">{tag}</span>
      ))}
    </div>
  )}

  <!-- Body -->
  <article class="prose">
    <Content />
  </article>
</Base>
