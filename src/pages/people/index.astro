---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPeople = await getCollection('people');
const currentMembers = allPeople.filter((p) => p.data.status === 'current');

// Role display order
const roleOrder = ['pi', 'postdoc', 'phd', 'masters', 'undergrad', 'visiting', 'staff'] as const;
const roleLabels: Record<string, string> = {
  pi: 'Principal Investigator',
  postdoc: 'Postdoctoral Researchers',
  phd: 'PhD Students',
  masters: 'Masters Students',
  undergrad: 'Undergraduate Students',
  visiting: 'Visiting Scholars',
  staff: 'Staff',
};

// Group by role
const byRole = new Map<string, typeof currentMembers>();
for (const person of currentMembers) {
  const group = byRole.get(person.data.role) ?? [];
  group.push(person);
  byRole.set(person.data.role, group);
}
---

<Base title="People" description="Current members of the MUSIC Lab.">
  <h1 class="mb-8 text-3xl font-semibold text-ink">People</h1>

  {roleOrder.map((role) => {
    const members = byRole.get(role);
    if (!members || members.length === 0) return null;
    return (
      <section class="mb-10">
        <h2 class="mb-6 text-xl font-semibold text-ink">{roleLabels[role]}</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {members.map((person) => (
            <div class="rounded-lg border border-line p-4">
              <h3 class="text-lg font-semibold text-ink">{person.data.name}</h3>
              <p class="text-sm text-muted">
                {roleLabels[person.data.role]} &middot; Joined {person.data.joined}
              </p>
              {person.data.bio && (
                <p class="mt-2 line-clamp-3 text-sm text-muted">{person.data.bio}</p>
              )}
              <div class="mt-3 flex gap-3 text-xs">
                {person.data.showEmail && person.data.email && (
                  <a href={`mailto:${person.data.email}`} class="text-accent hover:underline">Email</a>
                )}
                {person.data.scholar && (
                  <a href={person.data.scholar} class="text-accent hover:underline">Scholar</a>
                )}
                {person.data.github && (
                  <a href={`https://github.com/${person.data.github}`} class="text-accent hover:underline">GitHub</a>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    );
  })}

  <p class="mt-8 text-sm text-muted">
    <a href={url('/people/alumni')} class="text-accent hover:underline">View alumni &rarr;</a>
  </p>
</Base>
