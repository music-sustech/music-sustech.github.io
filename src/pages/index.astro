---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/homepage-photo.jpg';
import { url } from '../lib/url';

const allPubs = await getCollection('publications');
const recentPubs = allPubs
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 5);

const allNews = await getCollection('news');
const recentNews = allNews
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Base title="Home">
  <!-- Overview section -->
  <section class="mb-12">
    <div class="flex flex-col gap-6 sm:flex-row">
      <div class="flex-1 space-y-4">
        <p class="text-lg leading-relaxed text-ink">
          We are a group of researchers with a keen interest in many exciting areas of
          high-frequency and high-speed electronics. Our research interests include:
        </p>
        <ul class="list-disc space-y-2 pl-6 text-base leading-relaxed text-ink">
          <li>High-performance high-frequency (RF to THz) integrated circuits and systems;</li>
          <li>High-precision and high-speed optoelectronic sensors and systems;</li>
          <li>Applications of high-frequency electronics to biomedical, healthcare, industrial,
            environmental, and humanitarian problems;</li>
          <li>Novel microelectronic, optoelectronic, and photonic devices.</li>
        </ul>
        <p class="text-base leading-relaxed text-ink">
          Critical to our scientific research efforts is a pursuit of fundamental understanding
          of the engineering principles of high frequency electronics. A major mission of our
          work is to formulate and disseminate such understanding through university
          <a href={url('/teaching')} class="text-accent hover:underline">education</a>
          as well as community
          <a href={url('/outreach')} class="text-accent hover:underline">outreach</a>.
        </p>
      </div>
      <div class="shrink-0 sm:w-2/5">
        <Image
          src={heroPhoto}
          alt="MUSIC Lab"
          class="rounded-lg"
          widths={[320, 480]}
          sizes="(max-width: 640px) 100vw, 40vw"
        />
      </div>
    </div>
  </section>

  <!-- Two-column: publications + news -->
  <div class="grid gap-12 lg:grid-cols-5">
    <!-- Recent publications (3/5) -->
    <section class="lg:col-span-3">
      <h2 class="mb-6 text-2xl font-semibold text-ink">Recent Publications</h2>
      <ul class="space-y-6">
        {recentPubs.map((pub, i) => (
          <li class:list={['border-l-2 pl-4', i === 0 && pub.data.featured ? 'border-accent' : 'border-line']}>
            <div class="mb-1 flex items-center gap-2">
              <span class="rounded bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent">
                {pub.data.year}
              </span>
              <span class="text-xs text-muted">{pub.data.venueType}</span>
            </div>
            <a href={url(`/research/publications/${pub.id}`)} class="text-base font-medium leading-snug text-ink hover:text-accent">
              {pub.data.title}
            </a>
            <p class="mt-1 text-sm text-muted">
              {pub.data.authors.join(', ')}
            </p>
            <p class="text-sm text-muted italic">{pub.data.venue}</p>
            <div class="mt-2 flex gap-3 text-xs">
              {pub.data.pdf && (
                <a href={pub.data.pdf} class="text-accent hover:underline">PDF</a>
              )}
              {pub.data.doi && (
                <a href={`https://doi.org/${pub.data.doi}`} class="text-accent hover:underline">DOI</a>
              )}
            </div>
          </li>
        ))}
      </ul>
      <p class="mt-6">
        <a href={url('/research/publications')} class="text-sm font-medium text-accent hover:underline">
          View all publications &rarr;
        </a>
      </p>
    </section>

    <!-- Recent news (2/5) -->
    <section class="lg:col-span-2">
      <h2 class="mb-6 text-2xl font-semibold text-ink">News</h2>
      <ul class="space-y-6">
        {recentNews.map((item) => (
          <li>
            <time class="text-xs text-muted" datetime={item.data.date.toISOString().slice(0, 10)}>
              {item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <a href={url(`/updates/news/${item.id}`)} class="mt-1 block font-medium text-ink hover:text-accent">
              {item.data.title}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6">
        <a href={url('/updates/news')} class="text-sm font-medium text-accent hover:underline">
          All news &rarr;
        </a>
      </p>
    </section>
  </div>
</Base>
